NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://yugi:yugi@localhost:5433/yugi_h5?schema=public

# Generate real secrets locally, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Guest token lifetime (no refresh flow yet).
GUEST_TOKEN_TTL=12h

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
